# Server Configuration
PORT=8080
ENVIRONMENT=development

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/saas_clinic?sslmode=disable

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TOKEN_TTL=15
JWT_REFRESH_TOKEN_TTL=7

# Google OAuth (optional in development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/google/callback

# Evolution API / WhatsApp (optional in development)
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
WHATSAPP_WEBHOOK_SECRET=your-webhook-secret-for-security
WHATSAPP_WEBHOOK_URL=http://your-backend-url/api/v1/whatsapp/webhook

# Gupshup Official API (partner credentials)
GUPSHUP_API_URL=https://api.gupshup.io
GUPSHUP_API_KEY=

# Asaas Payment (optional in development)
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET=your-asaas-webhook-secret
ASAAS_SANDBOX=true

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=debug

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-app
SMTP_FROM=noreply@suaclinica.com
FRONTEND_URL=http://localhost:3000

# ==========================================
# REMINDER WORKER SETTINGS
# ==========================================

# Enable/disable the reminder worker
REMINDER_WORKER_ENABLED=true

# How often the worker scans for appointments needing reminders
# Format: Go duration (e.g., 15m, 1h, 30s)
REMINDER_WORKER_INTERVAL=15m

# ==========================================
# REMINDER THRESHOLDS
# ==========================================

# 48-hour reminder
REMINDER_48H_ENABLED=true
REMINDER_48H_BEFORE=48h

# 24-hour reminder
REMINDER_24H_ENABLED=true
REMINDER_24H_BEFORE=24h

# 2-hour reminder (day-of)
REMINDER_2H_ENABLED=true
REMINDER_2H_BEFORE=2h

# ==========================================
# MESSAGE RATE LIMITING
# ==========================================

# Seconds to wait between each message (to avoid WhatsApp rate limits)
MESSAGE_RATE_LIMIT_SECONDS=1

# Maximum retry attempts for failed messages
MESSAGE_RETRY_MAX=3

# Delay between retry attempts
MESSAGE_RETRY_DELAY=1m

# ==========================================
# RABBITMQ (Message Queue)
# ==========================================

# RabbitMQ connection URL
# For local development: amqp://guest:guest@localhost:5672/
# For CloudAMQP (production): amqps://user:pass@hostname/vhost
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Queue name for WhatsApp messages
RABBITMQ_QUEUE=whatsapp_messages

# Dead letter queue for failed messages
RABBITMQ_DLQ=whatsapp_messages_dlq

# AI Agent Configuration for WhatsApp
# Copy these settings to your .env file and adjust as needed

# ============================================================================
# AI AGENT MASTER SWITCH
# ============================================================================
# Enable/disable AI agent globally (default: false for safety)
AI_AGENT_ENABLED=false

# ============================================================================
# AI PROVIDER SELECTION
# ============================================================================
# Provider: "gemini" or "openrouter"
# - gemini: Google's Gemini models (requires GEMINI_API_KEY)
# - openrouter: Access to multiple open-source models (requires OPENROUTER_API_KEY)
AI_AGENT_PROVIDER=gemini

# ============================================================================
# GEMINI CONFIGURATION (when AI_AGENT_PROVIDER=gemini)
# ============================================================================
# Gemini API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Recommended Gemini models:
# - gemini-2.5-flash (best quality, recommended)
# - gemini-2.5-flash-lite (faster, cheaper)
# - gemini-2.0-flash (stable, good quality)
# AI_AGENT_MODEL=gemini-2.5-flash

# Fallback models (comma-separated, tried in order)
# AI_AGENT_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash

# ============================================================================
# OPENROUTER CONFIGURATION (when AI_AGENT_PROVIDER=openrouter)
# ============================================================================
# OpenRouter API Key (get from https://openrouter.ai/)
# OPENROUTER_API_KEY=your-openrouter-api-key-here

# Primary model (choose one):
# - meta-llama/llama-3.1-8b-instruct (recommended for quality)
# - mistralai/mistral-7b-instruct (fast, good quality)
# - google/gemma-7b-it (Google's open model)
# - qwen/qwen-2.5-7b-instruct (Alibaba's model)
# AI_AGENT_MODEL=meta-llama/llama-3.1-8b-instruct

# Fallback models (comma-separated, tried in order)
# AI_AGENT_FALLBACK_MODELS=mistralai/mistral-7b-instruct,google/gemma-7b-it,qwen/qwen-2.5-7b-instruct

# ============================================================================
# SHARED CONFIGURATION (applies to all providers)
# ============================================================================
# Maximum tokens to generate per response (default: 2048)
# Higher = longer responses but more cost
AI_AGENT_MAX_TOKENS=2048

# Temperature for generation (0.0 = deterministic, 1.0 = creative)
# Recommended: 0.5 for natural but rule-following responses
AI_AGENT_TEMPERATURE=0.5

# Stricter temperature for handoff mode only — when the clinic delegates
# schedule/reschedule/cancel to the human team and the AI is gathering
# context (tipo / dia-horário / profissional). Lower than the conversational
# default because handoff requires strict rule-following: call list_procedures
# for vague terms, format R$ X,XX, never call complete_handoff_to_human early.
# Recommended: 0.3
AI_AGENT_HANDOFF_TEMPERATURE=0.3

# Request timeout (default: 30s)
AI_AGENT_TIMEOUT=30s

# LangFuse Cloud observability (optional). When set, every LLM call is
# pushed as a generation event so you get hosted dashboards (cost per
# conversation, prompt diff, replay) without self-hosting anything.
# Setup:
#   1. Create account at https://cloud.langfuse.com (US region: us.cloud.langfuse.com)
#   2. Project Settings → API Keys → New
#   3. Paste public/secret keys here + match BASE_URL to your region.
# Leave empty to disable (fully no-op, no HTTP, no overhead).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Region: https://us.cloud.langfuse.com (US) or https://cloud.langfuse.com (EU)
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# USD -> BRL conversion factor used to compute AI cost estimates on the
# admin dashboard. Read once at startup; restart the backend after changing.
# Invalid values (non-numeric, zero, negative) fall back to the default 5.0.
USD_TO_BRL_RATE=5.0

# How many conversation turns to keep in context
CONVERSATION_MAX_TURNS=30

# How long to keep conversations in Redis cache (fast access)
CONVERSATION_REDIS_TTL=30m

# How long to keep conversations in PostgreSQL (persistent storage)
# Default: 90 days
CONVERSATION_POSTGRES_TTL=2160h

# How many past turns (user+assistant mix) are injected into the LLM prompt.
# Lower → reduces "memory-faulty" hallucination on cheap models (more tool calls).
# Higher → better continuity on strong models (gpt-4o, claude).
# Default 10 (~5 ida-e-voltas). Use 15-20 for gpt-4o-mini or better.
CONVERSATION_PROMPT_HISTORY_TURNS=10

# ============================================================================
# FEATURE FLAGS - GRADUAL ROLLOUT
# ============================================================================
# Enable AI agent for specific flows (all default to false)
# Start with scheduling, then gradually enable others

# Enable AI for new patient scheduling flow
AI_AGENT_SCHEDULING_ENABLED=false

# Enable AI for appointment confirmation flow
AI_AGENT_CONFIRM_ENABLED=false

# Enable AI for cancellation flow
AI_AGENT_CANCEL_ENABLED=false

# Enable AI for reschedule flow
AI_AGENT_RESCHEDULE_ENABLED=false

# Enable AI for reminder messages
AI_AGENT_REMINDERS_ENABLED=false

# ============================================================================
# ROLLOUT STRATEGY (EXAMPLES)
# ============================================================================

# Phase 1: Internal Testing with Gemini
# AI_AGENT_ENABLED=true
# AI_AGENT_PROVIDER=gemini
# GEMINI_API_KEY=your-key
# AI_AGENT_MODEL=gemini-2.5-flash
# AI_AGENT_SCHEDULING_ENABLED=true

# Phase 2: Testing with OpenRouter
# AI_AGENT_ENABLED=true
# AI_AGENT_PROVIDER=openrouter
# OPENROUTER_API_KEY=your-key
# AI_AGENT_MODEL=meta-llama/llama-3.1-8b-instruct
# AI_AGENT_SCHEDULING_ENABLED=true
# AI_AGENT_CONFIRM_ENABLED=true

# Phase 3: Full Rollout
# AI_AGENT_ENABLED=true
# AI_AGENT_SCHEDULING_ENABLED=true
# AI_AGENT_CONFIRM_ENABLED=true
# AI_AGENT_CANCEL_ENABLED=true
# AI_AGENT_RESCHEDULE_ENABLED=true
# AI_AGENT_REMINDERS_ENABLED=true

# ============================================================================
# MONITORING & COST CONTROL
# ============================================================================
# Monitor these metrics in production:
# - Token usage per conversation (cost tracking)
# - Tool call success rate per tool
# - Average response latency
# - Conversation completion rate
# - Fallback trigger rate

# Expected cost per conversation:
# - Gemini: Free tier (limited quota) or ~R$ 0.05-0.15
# - OpenRouter: ~R$ 0.02-0.10 (varies by model)

# Alert thresholds:
# - Latency p95 > 5 seconds
# - Error rate > 5%
# - Cost per conversation > R$ 0.20
