# Server Configuration
PORT=8080
ENVIRONMENT=development

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/saas_clinic?sslmode=disable

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TOKEN_TTL=15
JWT_REFRESH_TOKEN_TTL=7

# Google OAuth (optional in development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/google/callback

# Evolution API / WhatsApp (optional in development)
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
WHATSAPP_WEBHOOK_SECRET=your-webhook-secret-for-security
WHATSAPP_WEBHOOK_URL=http://your-backend-url/api/v1/whatsapp/webhook

# Asaas Payment (optional in development)
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET=your-asaas-webhook-secret
ASAAS_SANDBOX=true

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=debug

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-app
SMTP_FROM=noreply@suaclinica.com
FRONTEND_URL=http://localhost:3000

# ==========================================
# REMINDER WORKER SETTINGS
# ==========================================

# Enable/disable the reminder worker
REMINDER_WORKER_ENABLED=true

# How often the worker scans for appointments needing reminders
# Format: Go duration (e.g., 15m, 1h, 30s)
REMINDER_WORKER_INTERVAL=15m

# ==========================================
# REMINDER THRESHOLDS
# ==========================================

# 48-hour reminder
REMINDER_48H_ENABLED=true
REMINDER_48H_BEFORE=48h

# 24-hour reminder
REMINDER_24H_ENABLED=true
REMINDER_24H_BEFORE=24h

# 2-hour reminder (day-of)
REMINDER_2H_ENABLED=true
REMINDER_2H_BEFORE=2h

# ==========================================
# MESSAGE RATE LIMITING
# ==========================================

# Seconds to wait between each message (to avoid WhatsApp rate limits)
MESSAGE_RATE_LIMIT_SECONDS=1

# Maximum retry attempts for failed messages
MESSAGE_RETRY_MAX=3

# Delay between retry attempts
MESSAGE_RETRY_DELAY=1m

# ==========================================
# RABBITMQ (Message Queue)
# ==========================================

# RabbitMQ connection URL
# For local development: amqp://guest:guest@localhost:5672/
# For CloudAMQP (production): amqps://user:pass@hostname/vhost
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Queue name for WhatsApp messages
RABBITMQ_QUEUE=whatsapp_messages

# Dead letter queue for failed messages
RABBITMQ_DLQ=whatsapp_messages_dlq

# AI Agent Configuration for WhatsApp
# Copy these settings to your .env file and adjust as needed

# ============================================================================
# AI AGENT MASTER SWITCH
# ============================================================================
# Enable/disable AI agent globally (default: false for safety)
AI_AGENT_ENABLED=false

# ============================================================================
# AI PROVIDER CONFIGURATION
# ============================================================================
# Provider: gemini, claude, or openai (currently only gemini is implemented)
AI_AGENT_PROVIDER=gemini

# Gemini API Key (required if provider is gemini)
GEMINI_API_KEY=your-gemini-api-key-here

# Claude API Key (for future use)
# CLAUDE_API_KEY=your-claude-api-key-here

# OpenAI API Key (for future use)
# OPENAI_API_KEY=your-openai-api-key-here

# ============================================================================
# MODEL CONFIGURATION
# ============================================================================
# Primary model to use
# Recommended for production: gemini-2.0-flash-exp (best quality)
# Budget-friendly option: gemini-2.0-flash
AI_AGENT_MODEL=gemini-2.0-flash-exp

# Fallback model if primary fails or hits rate limit
AI_AGENT_FALLBACK_MODEL=gemini-2.0-flash

# Maximum tokens to generate per response (default: 2048)
# Higher = longer responses but more cost
AI_AGENT_MAX_TOKENS=2048

# Temperature for generation (0.0 = deterministic, 1.0 = creative)
# Recommended: 0.7 for natural but consistent responses
AI_AGENT_TEMPERATURE=0.7

# Request timeout (default: 30s)
AI_AGENT_TIMEOUT=30s

# ============================================================================
# CONVERSATION CONTEXT MANAGEMENT
# ============================================================================
# How long to keep conversations in Redis cache (fast access)
# Default: 30 minutes
CONVERSATION_REDIS_TTL=30m

# How long to keep conversations in PostgreSQL (persistent storage)
# Default: 7 days
CONVERSATION_POSTGRES_TTL=168h

# ============================================================================
# FEATURE FLAGS - GRADUAL ROLLOUT
# ============================================================================
# Enable AI agent for specific flows (all default to false)
# Start with scheduling, then gradually enable others

# Enable AI for new patient scheduling flow
AI_AGENT_SCHEDULING_ENABLED=false

# Enable AI for appointment confirmation flow
AI_AGENT_CONFIRM_ENABLED=false

# Enable AI for cancellation flow
AI_AGENT_CANCEL_ENABLED=false

# Enable AI for reminder messages
AI_AGENT_REMINDERS_ENABLED=false

# ============================================================================
# ROLLOUT STRATEGY (EXAMPLES)
# ============================================================================

# Phase 1: Internal Testing
# AI_AGENT_ENABLED=true
# AI_AGENT_SCHEDULING_ENABLED=true
# (All others false)

# Phase 2: Beta Testing with Select Clinics
# AI_AGENT_ENABLED=true
# AI_AGENT_SCHEDULING_ENABLED=true
# AI_AGENT_CONFIRM_ENABLED=true
# (Cancellation and reminders still false)

# Phase 3: Full Rollout
# AI_AGENT_ENABLED=true
# AI_AGENT_SCHEDULING_ENABLED=true
# AI_AGENT_CONFIRM_ENABLED=true
# AI_AGENT_CANCEL_ENABLED=true
# AI_AGENT_REMINDERS_ENABLED=true

# ============================================================================
# MONITORING & COST CONTROL
# ============================================================================
# Monitor these metrics in production:
# - Token usage per conversation (cost tracking)
# - Tool call success rate per tool
# - Average response latency
# - Conversation completion rate
# - Fallback trigger rate

# Expected cost per conversation: ~R$ 0.05-0.15
# Alert thresholds:
# - Latency p95 > 5 seconds
# - Error rate > 5%
# - Cost per conversation > R$ 0.20
